<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{BG}"
      TextElement.Foreground="{TEXT}"
      TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
      TextElement.FontSize="14">
  <Grid.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{CARD}"/>
      <Setter Property="BorderBrush" Value="{BORDER}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="20,18"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{SUB}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    </Style>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{TEXT}"/>
      <Setter Property="Background" Value="{BTN}"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{BTNHOVER}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ModeCard" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="18" Padding="22,20">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{ACCENT}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{TEXT}"/>
      <Setter Property="Margin" Value="0,10,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Grid.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,26,32,28" MaxWidth="820">

      <!-- Header -->
      <DockPanel Margin="0,0,0,22">
        <Border Width="52" Height="52" CornerRadius="14" DockPanel.Dock="Left">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#2979FF" Offset="0"/>
              <GradientStop Color="#9E57FF" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="26" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Monitor Switcher" FontSize="24" FontWeight="Bold"/>
          <TextBlock x:Name="HeaderStatus" Style="{StaticResource Sub}" Text="…"/>
        </StackPanel>
      </DockPanel>

      <!-- Who owns the monitors -->
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button x:Name="MacCard" Grid.Column="0" Style="{StaticResource ModeCard}" Height="150">
          <Grid>
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE770;" FontSize="30" VerticalAlignment="Top"/>
            <TextBlock x:Name="MacCheck" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="20"
                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock Text="Mac" FontSize="30" FontWeight="Bold"/>
              <TextBlock x:Name="MacCardSub" Opacity="0.85" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Button>
        <Button x:Name="PcCard" Grid.Column="2" Style="{StaticResource ModeCard}" Height="150">
          <Grid>
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE977;" FontSize="30" VerticalAlignment="Top"/>
            <TextBlock x:Name="PcCheck" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="20"
                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock Text="PC" FontSize="30" FontWeight="Bold"/>
              <TextBlock x:Name="PcCardSub" Opacity="0.85" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Button>
      </Grid>

      <!-- Mac connection -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Mac connection"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Ellipse x:Name="MacDot" Width="10" Height="10" VerticalAlignment="Center"/>
            <TextBlock x:Name="MacText" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <TextBlock x:Name="MacHint" Style="{StaticResource Sub}" Margin="0,10,0,0"/>
          <StackPanel x:Name="MacButtons" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="CheckMacBtn" Style="{StaticResource Btn}" Content="Check connection"/>
            <Button x:Name="UnpairBtn" Style="{StaticResource Btn}" Content="Unpair Mac"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Monitors -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="0" Content="Refresh"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Title}" Text="This PC's monitors"/>
              <TextBlock Style="{StaticResource Sub}" Text="The Mac can switch their inputs through this PC over DDC/CI."/>
            </StackPanel>
          </DockPanel>
          <ItemsControl x:Name="MonitorList" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{ROW}" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding InputText}" Foreground="{SUB}" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="22" Foreground="{ACCENT}" VerticalAlignment="Center"/>
                    <StackPanel Margin="14,0,12,0">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Detail}" Foreground="{SUB}" FontSize="12"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="NoMonitors" Style="{StaticResource Sub}" Text="Looking for monitors…"/>
        </StackPanel>
      </Border>

      <!-- Updates -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Button x:Name="UpdateBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="0" Content="Check now" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Title}" Text="Updates"/>
              <TextBlock x:Name="VersionText" Margin="0,4,0,0"/>
              <TextBlock x:Name="UpdateText" Style="{StaticResource Sub}"/>
            </StackPanel>
          </DockPanel>
          <CheckBox x:Name="AutoUpdateBox" Content="Install updates automatically"/>
        </StackPanel>
      </Border>

      <!-- Settings -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Settings"/>
          <CheckBox x:Name="AutostartBox" Content="Start with Windows (in the tray, no window)"/>
          <CheckBox x:Name="InputBox" Content="Take the monitors when I use this PC's keyboard or mouse"/>
          <TextBlock Style="{StaticResource Sub}" Margin="26,4,0,0"
                     Text="The Mac only switches if its keyboard or mouse has already left it, so a keyboard that just fell asleep never switches anything."/>
          <TextBlock x:Name="NetInfo" Style="{StaticResource Sub}" Margin="0,14,0,0"/>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="OpenLogBtn" Style="{StaticResource Btn}" Content="Open log folder"/>
            <Button x:Name="UninstallBtn" Style="{StaticResource Btn}" Content="Remove from this PC"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Log -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Activity"/>
          <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                   Foreground="{SUB}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Height="200"
                   VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Grid>
