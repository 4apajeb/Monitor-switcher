<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{BG}"
      TextElement.Foreground="{TEXT}"
      TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
      TextElement.FontSize="14"
      Width="460">
  <Grid.Resources>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{TEXT}"/>
      <Setter Property="Background" Value="{BTN}"/>
      <Setter Property="Padding" Value="20,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>
  <StackPanel Margin="28,26,28,24">
    <DockPanel>
      <Border Width="44" Height="44" CornerRadius="12" DockPanel.Dock="Left" VerticalAlignment="Top">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2979FF" Offset="0"/>
            <GradientStop Color="#9E57FF" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7F4;" FontSize="22" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Margin="16,0,0,0">
        <TextBlock Text="Pair with this Mac?" FontSize="20" FontWeight="Bold"/>
        <TextBlock x:Name="Message" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{SUB}" LineHeight="20"/>
      </StackPanel>
    </DockPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="DenyBtn" Style="{StaticResource Btn}" Content="Decline" Margin="0,0,10,0"/>
      <Button x:Name="AllowBtn" Style="{StaticResource Btn}" Content="Allow" Background="{ACCENT}" Foreground="White"/>
    </StackPanel>
  </StackPanel>
</Grid>
